# Utility Commands
# Run `just util` to see all utility commands

set dotenv-load := true

PROJECT_DIR := justfile_directory()
BIN_DIR := PROJECT_DIR / "bin"
COVERAGE_DIR := PROJECT_DIR / "coverage"
CLI_SNAPSHOT := PROJECT_DIR / "test/testdata/cli_snapshot/help.txt"

[private]
@default:
    @echo "Utility Commands"
    @echo "================"
    @just --list --justfile {{source_file()}}

# Clean build artifacts
clean:
    @echo "Cleaning build artifacts..."
    rm -rf {{BIN_DIR}}
    rm -rf {{COVERAGE_DIR}}
    go clean -cache -testcache
    @echo "Clean complete"

# Download and verify dependencies
deps:
    @echo "Downloading dependencies..."
    go mod download
    go mod verify
    @echo "Dependencies ready"

# Tidy dependencies
tidy:
    @echo "Tidying dependencies..."
    go mod tidy
    @echo "Dependencies tidied"

# Tidy all modules
tidy-all:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "Tidying all modules..."
    while IFS= read -r -d '' modfile; do
        moddir=$(dirname "$modfile")
        echo "  - ${moddir}"
        (cd "$moddir" && go mod tidy)
    done < <(find "{{PROJECT_DIR}}" -name go.mod -print0)
    echo "All modules tidied"

# Run linters (fmt + vet)
lint:
    @echo "Running linters..."
    go fmt {{PROJECT_DIR}}/...
    go vet {{PROJECT_DIR}}/...
    @echo "Linting complete"

# Fix common issues (format + tidy)
fix: lint tidy
    @echo "Fixes applied"

# Start godoc server
docs:
    @echo "Starting godoc server at http://localhost:6060"
    @echo "Press Ctrl+C to stop"
    godoc -http=:6060

# Show version info
version:
    @echo "Go version:"
    go version
    @echo ""
    @echo "Module info:"
    go list -m

# Check Go installation
check-go:
    #!/usr/bin/env bash
    if ! command -v go &> /dev/null; then
        echo "Error: Go is not installed"
        exit 1
    fi
    GO_VERSION=$(go version | awk '{print $3}' | sed 's/go//')
    echo "Go version: $GO_VERSION"
    MAJOR=$(echo $GO_VERSION | cut -d. -f1)
    MINOR=$(echo $GO_VERSION | cut -d. -f2)
    if [[ $MAJOR -lt 1 ]] || [[ $MAJOR -eq 1 && $MINOR -lt 22 ]]; then
        echo "Error: Go >= 1.22 required"
        exit 1
    fi
    echo "Go version OK"

# Check grok CLI installation
check-grok:
    #!/usr/bin/env bash
    if ! command -v grok &> /dev/null; then
        echo "Warning: grok CLI not found in PATH"
        echo "Install from: https://github.com/xai-org/grok"
        exit 1
    fi
    echo "grok CLI found: $(which grok)"
    grok --version

# Print the resolved grok binary path
grok-path:
    @command -v grok || (echo "grok not on PATH"; exit 1)

# Check live grok help output against the committed snapshot
cli-drift:
    #!/usr/bin/env bash
    set -euo pipefail
    if ! command -v grok >/dev/null 2>&1; then
        echo "grok CLI not found in PATH"
        exit 1
    fi
    tmp=$(mktemp)
    trap 'rm -f "$tmp"' EXIT
    just --justfile "{{source_file()}}" _cli-help-snapshot "$tmp"
    diff -u "{{CLI_SNAPSHOT}}" "$tmp"

# Refresh the committed grok help snapshot from the live binary
cli-drift-update:
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p "$(dirname "{{CLI_SNAPSHOT}}")"
    just --justfile "{{source_file()}}" _cli-help-snapshot "{{CLI_SNAPSHOT}}"
    echo "Updated {{CLI_SNAPSHOT}}"

[private]
_cli-help-snapshot output:
    #!/usr/bin/env bash
    set -euo pipefail
    commands=(
        ""
        "agent"
        "agent stdio"
        "agent headless"
        "agent serve"
        "agent leader"
        "leader"
        "leader list"
        "leader info"
        "leader kill"
        "leader profile"
        "leader profile status"
        "leader profile start"
        "leader profile stop"
        "mcp"
        "mcp list"
        "mcp add"
        "mcp remove"
        "mcp doctor"
        "memory"
        "memory clear"
        "worktree"
        "worktree list"
        "worktree show"
        "worktree rm"
        "worktree gc"
        "worktree db"
        "worktree db rebuild"
        "worktree db stats"
        "worktree db path"
        "sessions"
        "sessions list"
        "sessions search"
        "sessions delete"
        "plugin"
        "plugin list"
        "plugin install"
        "plugin uninstall"
        "plugin update"
        "plugin enable"
        "plugin disable"
        "plugin details"
        "plugin validate"
        "plugin tag"
        "plugin marketplace"
        "plugin marketplace list"
        "plugin marketplace add"
        "plugin marketplace remove"
        "plugin marketplace update"
        "import"
        "inspect"
        "export"
        "login"
        "logout"
        "models"
        "setup"
        "trace"
        "update"
        "version"
        "completions"
    )
    {
        printf '# grok CLI help snapshot\n'
        printf '# Generated by: just cli-drift-update\n'
        printf '\n'
        for cmd in "${commands[@]}"; do
            if [ -z "$cmd" ]; then
                printf '## grok --help\n\n'
                grok --help
            else
                printf '## grok %s --help\n\n' "$cmd"
                read -r -a argv <<< "$cmd"
                grok "${argv[@]}" --help
            fi
            printf '\n'
        done
    } | sed -E 's/[[:space:]]+$//' > "{{output}}"
